{
  "name": "SpendWiser WhatsApp to MongoDB Tracker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-spendwiser",
        "options": {}
      },
      "id": "1",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-3.5-turbo",
        "prompt": "=Extract the transaction details from this WhatsApp message: \"{{ $json.body.Body || $json.body.messages[0].text.body }}\"\n\nReturn ONLY a valid JSON object with the following keys:\n- amount (number)\n- type (string: \"expense\" or \"income\")\n- category (string: \"Food\", \"Transport\", \"Entertainment\", \"Shopping\", \"Bills\", or \"Other\")\n- description (string: short description of the expense)\n- date (string: current date in ISO format, e.g. 2026-03-10T00:00:00.000Z)\n- walletId (string: \"1\" for Main, \"2\" for Cash)",
        "jsonOutput": true
      },
      "id": "2",
      "name": "AI Parser (OpenAI/Gemini)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/api/transactions",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "amount",
              "value": "={{ JSON.parse($json.text).amount }}"
            },
            {
              "name": "type",
              "value": "={{ JSON.parse($json.text).type }}"
            },
            {
              "name": "category",
              "value": "={{ JSON.parse($json.text).category }}"
            },
            {
              "name": "description",
              "value": "={{ JSON.parse($json.text).description }}"
            },
            {
              "name": "date",
              "value": "={{ JSON.parse($json.text).date }}"
            },
            {
              "name": "walletId",
              "value": "={{ JSON.parse($json.text).walletId || '2' }}"
            },
            {
              "name": "currency",
              "value": "INR"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Send to SpendWiser Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "WhatsApp Webhook": {
      "main": [
        [
          {
            "node": "AI Parser (OpenAI/Gemini)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Parser (OpenAI/Gemini)": {
      "main": [
        [
          {
            "node": "Send to SpendWiser Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
